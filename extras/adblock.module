#!name=通用去广告（B站 + 番茄/红果 + 微博）
#!desc=2026-10-30 通用版：把 B站、番茄小说、红果短剧、微博的广告拦截合并为这一个模块（原来的 bilibili/bytedance/weibo 三个模块已删除）。纯域名 + URL 改写 + 可选 MITM；默认不启用任何第三方脚本、不含证书。B站第 3/4 层与番茄 HTTPS 改写层需要开启 HTTPS 解密；红果、微博、B站第 1/2 层不需要。按远程模块 URL 安装后可随 Shadowrocket 自动更新。
#!author=本地整理（来源：blackmatrix7、deezertidal/bm7、BiliUniverse/ADBlock、SherryBX/XiaoQi、q85985477/shadowrocket-modules、qq2519157/adblock-modules（MIT © 2026 logan）、2026-10-29/30 真机日志）
#!homepage=https://github.com/HyPerP/shadowrocket-rules
#!version=1.0
#!date=2026-10-30

# ============================================================
# 通用去广告模块（单文件版）——结构、顺序与依赖
#
# 【合并来源】2026-10-30 合并自三个已删除的 App 模块：
#   · bilibili-adblock.module（B站开屏三层 + 站内推广规则，v2）
#   · bytedance-adblock.module（番茄 + 红果，含原 fanqie 模块迁移 + 红果 v1.4 MIT）
#   · weibo-adblock.module（微博开屏/广告 SDK）
#   合并时做过跨模块冲突检查：同域不同策略 0 组、重复 URL 改写 0 条。
#
# 【三段顺序不可随意调换】
#   1) [Rule] 第一部分 = 字节系（番茄/红果）：A 段正片 DIRECT 白名单在前，例外 REJECT 必须在
#      更宽泛的 DIRECT 之前（如 v*-novelapp*.fqnovelvod.com 的 REJECT 要排在 fqnovelvod.com DIRECT 前）；
#      这一段内部顺序是刻意的，不要改。
#   2) 第二部分 = B 站：广告域 → 开屏素材/接口/站内推广（无 DIRECT 规则，不受上段影响）。
#   3) 第三部分 = 微博：纯广告子域 REJECT。
#   三段之间没有同域冲突；如需临时停用某一 App 的规则，按段落注释即可。
#
# 【是否需要 HTTPS 解密】
#   · 不需要证书：字节系第 1 层 + 红果全部、微博全部、B站第 1/2 层（域名 + 明文 HTTP 素材）
#   · 需要解密：B站第 3/4 层（splash 接口 + 站内推广接口）、番茄 HTTPS URL 改写层
#     开启方法：配置 → ⓘ → HTTPS 解密 → 生成/安装自签 CA → 打开开关；[MITM] 已用 %APPEND% 追加。
#   · 红果不依赖 MITM（TTNet Cronet 拒绝用户 CA，上游已定案）；不要开解密也能用。
#
# 【安装 / 自动更新】
#   远程：配置 → 模块 → 右上角 + → 填链接 →
#     https://cdn.jsdelivr.net/gh/HyPerP/shadowrocket-rules@main/extras/adblock.module
#   自动更新：Shadowrocket → 自动更新 → 模块 → 自动后台更新（间隔 1 天）+ iOS 后台 App 刷新。
#   手动/本地：复制全文 → 模块 → 新建模块 → 粘贴保存。
#
# 【安全】
#   · 只用你自己生成的自签 CA；模块不含证书/私钥，不启用第三方脚本，不引用公共 CA。
#   · 若某 App 因证书锁定（pinning）异常：关闭当前配置的 HTTPS 解密（纯域名层仍有效）或停用本模块。
#   · 字节系模块会同时影响抖音/头条的部分穿山甲广告与统计（预期）；B站第 4 层会让活动位/
#     搜索默认词/小卡片消失；不需要时按段落注释。
#
# 【来源与许可】
#   blackmatrix7（GPL-2.0，仅参考开屏 show/list 思路）、deezertidal/shadowrocket-rules（bm7 规则）、
#   BiliUniverse/ADBlock（Apache-2.0，规则路径/隐私追踪域）、SherryBX/XiaoQi-sgmodule、
#   q85985477/shadowrocket-modules、qq2519157/adblock-modules（MIT）。
#   公开分发请保留本段来源标注并遵守各上游许可证。
# ============================================================

[Rule]
# ==========================================================================
# 第一部分：字节系（番茄小说 + 红果短剧）—— 顺序不可调换
# ==========================================================================

# ============================================================
# 从上到下命中即停；带 pre-matching 的 REJECT 规则会被提前求值（最高优先级）。
# 因此凡与「正片 DIRECT 白名单」有交集的域名，一律不加 pre-matching（如 p*-ad-sign、ecombdapi）。
# 若旧版 iOS 加载报错：把本文件中所有 ",pre-matching" 删掉即可退回（红果 v1.4 的降级方案）。
# ============================================================

# ─────────── A. 正片保护（必须最前；例外 REJECT 必须在宽泛 DIRECT 之前）───────────
# A1. 红果「剧集间贴片/插屏」广告视频（都在 qznovelvod 上，正片是 reading-video 前缀）
DOMAIN-WILDCARD,v*-reading-ad.qznovelvod.com,REJECT,extended-matching,pre-matching
DOMAIN-WILDCARD,v*-bd-daily-reading-ad.qznovelvod.com,REJECT,extended-matching,pre-matching
DOMAIN-WILDCARD,v*-se-daily-reading-ad.qznovelvod.com,REJECT,extended-matching,pre-matching
DOMAIN-WILDCARD,v*-se-sjy-daily-reading-ad.qznovelvod.com,REJECT,extended-matching,pre-matching

# A2. 番茄广告视频子域（原 fanqie 模块 D 段；2026-10-29 真机日志里 v9/v26/v11-novelapp.fqnovelvod.com
#     被 REJECT 2262 次 = 广告视频确实被拦到）。必须排在 A3 的 fqnovelvod 整域 DIRECT 之前。
DOMAIN-WILDCARD,v*-novelapp*.fqnovelvod.com,REJECT,extended-matching,pre-matching
DOMAIN-WILDCARD,v*-ad*.fqnovelvod.com,REJECT,extended-matching,pre-matching
# 兜底（原 fanqie 模块注释行，默认关闭）：视频广告复发且不在乎番茄内正常视频时取消注释。
# 取消后必须留在本行位置（A3 之前），否则会被 fqnovelvod 整域 DIRECT 挡住而不生效。
#DOMAIN-SUFFIX,fqnovelvod.com,REJECT,extended-matching,pre-matching

# A3. 正片/听书/图床/内容 API 白名单（来自红果 v1.4，全部 DIRECT）
#     extended-matching = 同时按 SNI 匹配，覆盖 App 用 HTTPDNS 裸 IP 直连的场景。
DOMAIN-SUFFIX,fqnovelvod.com,DIRECT,extended-matching
DOMAIN-WILDCARD,v*-reading-video*.qznovelvod.com,DIRECT,extended-matching
DOMAIN-WILDCARD,v*-reading-videocdn*.qznovelvod.com,DIRECT,extended-matching
DOMAIN,n98-v-readingvideo.qznovelvod.com,DIRECT,extended-matching
DOMAIN-WILDCARD,*-fq-tts.fqnovelvod.com,DIRECT,extended-matching
DOMAIN-SUFFIX,qznovelvod.com,DIRECT,extended-matching
DOMAIN-WILDCARD,p*-novel*.byteimg.com,DIRECT,extended-matching
# p3-ad-sign / p3-tt 是上游标注的正片签名图床：先 DIRECT，p6/p9 等广告签名图床由 F 段的
# p*-ad-sign 通配 REJECT 接管（p3 命中 A3 即停，不会被 F 段误杀）。
DOMAIN,p3-ad-sign.byteimg.com,DIRECT,extended-matching
DOMAIN,p3-tt.byteimg.com,DIRECT,extended-matching
DOMAIN-WILDCARD,api*-normal.fqnovel.com,DIRECT,extended-matching
DOMAIN-WILDCARD,api*-normal-*.fqnovel.com,DIRECT,extended-matching
DOMAIN-WILDCARD,frontier*-toutiao-lq.fqnovel.com,DIRECT,extended-matching
DOMAIN-WILDCARD,lf*-reading.fqnovelstatic.com,DIRECT,extended-matching
DOMAIN-WILDCARD,lf*-reading*.fqnovelpic.com,DIRECT,extended-matching
DOMAIN-SUFFIX,hongguo.com,DIRECT,extended-matching
DOMAIN-SUFFIX,hongguo.douyin.com,DIRECT,extended-matching
# A4. 可选：UG/金币挂件域（红果 v1.4 反编译实证 api*-normal-sinfonline* 挂件模板）；
#     想连挂件/约读任务一起杀就取消注释（默认关闭，与「想用商城就关 K 段」同一哲学）。
#     注意：取消注释后必须挪到上面 A3 的 api*-normal-* 白名单之前，否则被白名单挡住。
#DOMAIN-WILDCARD,api*-normal-sinfonline*.fqnovel.com,REJECT,extended-matching,pre-matching

# ─────────── B. 断 HTTPDNS 旁路（逼 App 回退系统 DNS，A/H 段域名规则才有效）───────────
# 依据：红果 v1.4（TTNet setTTDNSServerHost("dig.bdurl.net")，备用 dig.zjurl.cn；硬编码
#       IP 表 101.36.166.16-19 恰为 4 个地址 → /30）+ 2026-10-29 真机日志。
# 说明（2026-10-30 QA）：DOMAIN-KEYWORD,httpdns 会拒绝设备上所有含 httpdns 的域名，可能误伤其它
#       App 的 HTTPDNS 端点；默认注释。红果/番茄已知 HTTPDNS 域由下面两条精确规则覆盖；
#       需要更激进（红果换用未知 httpdns 子域）时再取消注释：
# DOMAIN-KEYWORD,httpdns,REJECT,extended-matching,pre-matching
DOMAIN,dig.bdurl.net,REJECT,extended-matching,pre-matching
DOMAIN,dig.zjurl.cn,REJECT,extended-matching,pre-matching
IP-CIDR,101.36.166.16/30,REJECT,no-resolve
IP-CIDR,180.96.2.114/32,REJECT,no-resolve

# ─────────── C. 红果「直播带货卡片」信令域（断粮道；v1.2/v1.3）───────────
# 证据：2026-10-25 实机抓包 webcast*-open-hl / content-open 与广告弹出秒级同行；四独立上游印证。
# 代价：红果/抖音内跳真实直播间会失效（直播广告落地页，属预期）。
DOMAIN-WILDCARD,webcast*-open*.douyin.com,REJECT,extended-matching,pre-matching
DOMAIN,webcast-open.douyin.com,REJECT,extended-matching,pre-matching
DOMAIN-WILDCARD,webcast*-open*.douyin.com.c.dsa.cdnbuild.net,REJECT,extended-matching,pre-matching
DOMAIN,content-open.douyin.com,REJECT,extended-matching,pre-matching
# 勿拦（红果 v1.4 多源实测误伤）：p*-webcast*.douyinpic.com=封面白屏；pull-lls-*=推送共用；
# webcast5-ws-web-*=真直播弹幕 WS；douyinpic.com/ecombdimg.com=通用图床；
# bytegecko.com=H5 离线包；pitaya.bytedance.com=播放器配置；amemv.com=抖音主域。

# ─────────── D. 字节系广告投放/配置下发接口 ───────────
# D1. 红果/番茄自家广告投放：只拦 ads*-normal / minigame*-normal 子域（-hl/-lf/-lq 机房全覆盖），
#     不整域拒 zijieapi.com（否则误伤 mssdk/imapi/gecko/bsync/polaris 等非广告接口）。
DOMAIN-WILDCARD,ads*-normal.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN-WILDCARD,ads*-normal-*.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN-WILDCARD,minigame*-normal.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN-WILDCARD,minigame*-normal-*.zijieapi.com,REJECT,extended-matching,pre-matching
# D2. 广告/运营配置下发（TNC，dns105 内置表 send_tnc_host_arrays 实证）
DOMAIN-WILDCARD,tnc*-bjlgy*.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN-WILDCARD,tnc*-bjlgy*.bytedance.com,REJECT,extended-matching,pre-matching
DOMAIN,tnc3-alisc1.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN,tnc3-aliec2.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN,tnc0-alisc1.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN,tnc0-aliec2.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN,tnc3-alisc1.snssdk.com,REJECT,extended-matching,pre-matching
DOMAIN,tnc3-aliec2.snssdk.com,REJECT,extended-matching,pre-matching
# D3. 电商推广位（红果内置商城）：想用红果商城就注释这一段；上游红果 v1.4 同样不加 pre-matching，
#     方便你用更靠上/更靠下的规则覆盖它。
DOMAIN-WILDCARD,ecom*-normal*.ecombdapi.com,REJECT,extended-matching
DOMAIN-WILDCARD,ec*-core*.ecombdapi.com,REJECT,extended-matching
DOMAIN-WILDCARD,isaas*-normal*.ecombdapi.com,REJECT,extended-matching

# ─────────── E. 穿山甲 / Pangle 广告 SDK（原 fanqie 模块 B 段）───────────
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,pglstatp-toutiao-b.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,pangolin16.isnssdk.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,pangolin16.sgsnssdk.com,REJECT,extended-matching,pre-matching
DOMAIN-WILDCARD,pangolin*.snssdk.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,pangle.io,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,pangle-ads.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,pangle-b.io,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,pangle.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,ad.pangle.cn,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,ad.pangolin.cn,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,oceanengine.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,byteorge.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,bytegoofy.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,csjplatform.com,REJECT,extended-matching,pre-matching

# ─────────── F. 广告素材签名 / 弹窗落地页 / 随机子域广告 CDN ───────────
# F1. 广告签名图床（p3-ad-sign 已在 A3 白名单；p6/p9 等由通配接管；本段不加 pre-matching，
#     否则会压掉 A3 的 p3-ad-sign/p3-tt DIRECT 例外）。
DOMAIN-WILDCARD,p*-ad-sign.byteimg.com,REJECT,extended-matching
DOMAIN,p3-mgsdk-sign.byteimg.com,REJECT,extended-matching
DOMAIN,p9-mgsdk-sign.byteimg.com,REJECT,extended-matching
DOMAIN,p1-luckycatopen.byteimg.com,REJECT,extended-matching
DOMAIN-WILDCARD,p*-developer-sign.bytemaimg.com,REJECT,extended-matching
# F2. 广告弹窗/跳转/落地页（均有证书固定，域名层 REJECT 在 TLS 握手前生效，不受 pinning 影响）
DOMAIN,zlink.ugsdk.cn,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,praisewindow.ugsdk.cn,REJECT,extended-matching,pre-matching
DOMAIN,praisewindow-sinfonlinea.ugsdk.cn,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,chengzijianzhan.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,activity-ag.awemeughun.com,REJECT,extended-matching,pre-matching
DOMAIN,sf3-ttcdn-tos.pstatp.com,REJECT,extended-matching,pre-matching
# F3. 随机子域广告 CDN（安卓实抓确认的伪装域名，iOS 侧未全部验证，异常可整段注释）
DOMAIN-SUFFIX,comfylink.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,ndcpp.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,ydycdn.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,qrstuvwxyzab.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,wuchuyun.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,xinqiucc.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,jomoxc.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,wmzfylgdsz.com,REJECT,extended-matching,pre-matching

# ─────────── G. 番茄视频 CDN 广告子域 / 西瓜「小说 App」素材 ───────────
# 原 fanqie 模块 D 段 + E 段 URL-REGEX 的域名层升级（URL-REGEX 需要解密才能看到完整 URL，
# 域名通配不需要证书，二者同时保留、互为兜底）。
DOMAIN-SUFFIX,novelapp.ixigua.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,v6-novelapp.ixigua.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,default.ixigua.com,REJECT,extended-matching,pre-matching
DOMAIN-WILDCARD,v*-ad.ixigua.com,REJECT,extended-matching,pre-matching
DOMAIN-WILDCARD,v*-dc-ad.ixigua.com,REJECT,extended-matching,pre-matching

# ─────────── H. 埋点 / 统计 / 广告监测（不影响播放；App 功能异常时先注释 i*.snssdk 几行）───────────
# H1. 字节系通用统计（原 fanqie 模块 C 段）
DOMAIN,i.snssdk.com,REJECT,extended-matching,pre-matching
DOMAIN,i-lq.snssdk.com,REJECT,extended-matching,pre-matching
DOMAIN,i-hl.snssdk.com,REJECT,extended-matching,pre-matching
# 例外说明：红果 v1.4 为了避免 SDK 反复重试，把 is.snssdk.com 改为「放行 + 信封脚本」；
# 本模块默认不启用脚本，所以沿用原 fanqie 模块的 REJECT。若观察到穿山甲反复重试/耗电，
# 可注释本行（= 上游做法）。is-lq/is-hl 同理（上游也是注释状态）。
DOMAIN,is.snssdk.com,REJECT,extended-matching,pre-matching
DOMAIN,ib-lq.snssdk.com,REJECT,extended-matching,pre-matching
DOMAIN,mcs.snssdk.com,REJECT,extended-matching,pre-matching
DOMAIN,security-lq.snssdk.com,REJECT,extended-matching,pre-matching
DOMAIN,gurd.snssdk.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,log.snssdk.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,log-hl.snssdk.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,mon.snssdk.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,ib.snssdk.com,REJECT,extended-matching,pre-matching
DOMAIN,mon.toutiaocloud.net,REJECT,extended-matching,pre-matching
DOMAIN,mon.toutiaocloud.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,ad.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,applog.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,mon.zijieapi.com,REJECT,extended-matching,pre-matching
# H2. 番茄埋点/推送（A 段 low-risk 子域 + E 段机房变体；QUIC/UDP 也适用）
# 注意：frontier*-toutiao-lq 在 A3 被白名单放行（上游红果标注为推送通道），这里只拒 -lf 机房，
#       来自原 fanqie 模块（2026-10-29/30 日志段）。两者后缀不同、不冲突；若番茄推送异常先注释本行。
DOMAIN-SUFFIX,frontier100-toutiao-lf.fqnovel.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,mon11-misc-lq.fqnovel.com,REJECT,extended-matching,pre-matching
DOMAIN-KEYWORD,applog-lf.fqnovel.com,REJECT,extended-matching,pre-matching
DOMAIN-WILDCARD,mon*-misc*.fqnovel.com,REJECT,extended-matching,pre-matching
DOMAIN-WILDCARD,log*-applog*.fqnovel.com,REJECT,extended-matching,pre-matching
DOMAIN-WILDCARD,rtlog*-applog*.fqnovel.com,REJECT,extended-matching,pre-matching
# H3. 红果 v1.4 补的 fqnovel 关键词形态（原 fanqie 模块没有，机房后缀夹在中间时通配更稳）
# 这两条不加 pre-matching：避免提前求值压过 A 段正片白名单（QA 2026-10-30 构造域名实测冲突）
DOMAIN-KEYWORD,applog.fqnovel.com,REJECT,extended-matching
DOMAIN-KEYWORD,-misc.fqnovel.com,REJECT,extended-matching
# H4. XiaoQi v1.9 抽取的字节埋点精确域（原 fanqie 模块未覆盖）
DOMAIN,log.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN,analytics.snssdk.com,REJECT,extended-matching,pre-matching
DOMAIN,applog.snssdk.com,REJECT,extended-matching,pre-matching
# H5. 广告效果监测（2026-10-29 日志里 g.cn.miaozhen.com 未被拦）
DOMAIN-SUFFIX,miaozhen.com,REJECT,extended-matching,pre-matching

# ─────────── I. URL-REGEX（原 fanqie 模块 E 段；HTTPS 需 MITM 才能看到完整 URL）───────────
# 域名层等价规则已在 G/H 段补齐（不需解密）；本段保留原始写法，供已开解密的场景精确匹配。
# 2026-10-30 QA：这两条 URL-REGEX 需要 [MITM] 覆盖 *.ixigua.com 才能看到 HTTPS 完整 URL，
# 否则是「看似生效、实际静默失效」；域名层 G 段已覆盖等价广告子域，故默认注释。
# 启用前请把 *.ixigua.com 加进 [MITM] hostname：
# URL-REGEX,v[^\/]*\-ad\.ixigua\.com(?![\w.-]),REJECT
# URL-REGEX,v[^\/]*\-dc\-ad\.ixigua\.com(?![\w.-]),REJECT
URL-REGEX,mon[^\/]*\-misc\.fqnovel\.com(?![\w.-]),REJECT
URL-REGEX,[^\/]*log[^\/]*\-applog[^\/]*\.fqnovel\.com(?![\w.-]),REJECT
URL-REGEX,mon[^\/]*\-misc\-[^\/]*\.fqnovel\.com(?![\w.-]),REJECT

